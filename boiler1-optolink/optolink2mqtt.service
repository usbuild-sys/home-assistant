# /etc/systemd/system/optolink2mqtt.service
[Unit]
Description=Viessmann Optolink to MQTT
After=network-online.target
Wants=network-online.target

[Service]
Environment=OPTOLINK2MQTT_CONFIG=/etc/optolink2mqtt/optolink2mqtt.yaml
EnvironmentFile=/etc/optolink2mqtt/env
ExecStart=/opt/optolink2mqtt/bin/optolink2mqtt
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
